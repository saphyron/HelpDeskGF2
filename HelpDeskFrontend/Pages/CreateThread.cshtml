@page
@model CreateThreadModel

<form method="post">
    <label>Title</label>
    <input asp-for="Title" />

    <label>Message</label>
    <textarea asp-for="Body"></textarea>

    @if (Model.IsAnonymous)
    {
        <label>Your name</label>
        <input asp-for="AnonymousName" />
    }

    <button type="submit">Create</button>
</form>

<div asp-validation-summary="All"></div>