@page
@model HomepageModel
@{
    ViewData["Title"] = "Homepage";
}

<partial name="Shared/TitlePage" />

<div class="cards">
@{
    var role = HttpContext.Session.GetString("Role");
}

@if (role != "guest")
{
    <a asp-page="/Tickets/UserTicket">Opret ticket</a>
}

<a asp-page="/Tickets/TicketList">Se tickets</a>

<a asp-page="/Threads/Forum">Forum</a>

@if (role == "admin")
{
    <a asp-page="/Admin/AdminTickets">Admin</a>
}
</div>
