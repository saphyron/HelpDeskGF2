<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - HelpDesk</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>

@{
    var isLoggedIn = Context.Session.GetInt32("UserId") != null;
    var username = Context.Session.GetString("Username");
    var role = Context.Session.GetString("Role");
}

<header>
    <!-- DESKTOP NAV -->
    <nav class="desktop-nav">
        <a asp-page="/Home/Homepage">Home</a>
        <a asp-page="/Tickets/TicketList">Tickets</a>
        <a asp-page="/Threads/Forum">Forum</a>

        @if (isLoggedIn)
        {
            <span>Hello, @username, you have the role @role</span>

            @if (role == "admin")
            {
                <a asp-page="/Admin/AdminTickets">Admin</a>
            }

            <form method="post" action="/Home/Logout" style="display:inline;">
                @Html.AntiForgeryToken()
                <button type="submit" class="logout-btn">Log out</button>
            </form>
        }
        else
        {
            <a asp-page="/Home/index">Login</a>
        }
    </nav>
</header>

<main>
    @RenderBody()
</main>

<footer>
    <p>HelpDesk © 2026 - John Høeg</p>
</footer>

</body>
</html>