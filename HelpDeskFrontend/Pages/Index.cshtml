@page
@model IndexModel
<h2>Login</h2>

<form method="post">
    <label>Brugernavn:</label>
    <input asp-for="Username" />

    <label>Password:</label>
    <input asp-for="Password" type="password" />

    <button type="submit">Login</button>
</form>

@if (Model.Error != null)
{
    <p style="color:red">@Model.Error</p>
}