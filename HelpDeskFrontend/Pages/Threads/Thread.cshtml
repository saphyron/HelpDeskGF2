@page
@model ThreadModel

<h1>@Model.CurrentThread!.Title</h1>

<p>
    @Model.CurrentThread.ThreadBody
</p>

<hr />

<h2>Replies</h2>

@if (Model.CurrentThread.Responses.Count == 0)
{
    <p><em>No replies yet</em></p>
}
else
{
    <ul>
        @foreach (var response in Model.CurrentThread.Responses)
        {
            <li>
                <strong>
                    @(response.CreatedByUserId != null
                        ? $"User #{response.CreatedByUserId}"
                        : response.AnonymousName)
                </strong>
                <br />
                @response.ResponseBody
            </li>
        }
    </ul>
}

<hr />

<h2>Add reply</h2>

<form method="post">
    <textarea asp-for="ResponseText"></textarea>

    @if (Model.IsAnonymous)
    {
        <label>Your name</label>
        <input asp-for="AnonymousName" />
    }

    <button type="submit">Reply</button>
</form>

<div asp-validation-summary="All"></div>