@page
@model UserTicketModel
<h2>Get Help Ticket</h2>

<p>You are number <strong>@Model.TicketCount</strong> in line.</p>

@if (Model.IsGuest) {
    <p class="text-warning"> As a guest you can not create a ticket</p>
} else {

    <form method="post">
        <button>Create Ticket</button>
    </form>
}